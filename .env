# ===========================================
# TRACKING SPESE - Environment Configuration
# ===========================================

# ------------------
# Database
# ------------------
POSTGRES_DB=tracking_spese
POSTGRES_USER=tracking_user
POSTGRES_PASSWORD=tracking_password

# ------------------
# Backend API
# ------------------
# Per sviluppo locale usa porta 5433 per evitare conflitti
DATABASE_URL=postgresql://tracking_user:tracking_password@localhost:5433/tracking_spese
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=30d
NODE_ENV=development
PORT=3001

# ------------------
# Frontend
# ------------------
# In sviluppo locale
FRONTEND_URL=http://localhost:8080
# API URL per sviluppo locale - usa path relativo
VITE_API_URL=/api
# Per build produzione
# VITE_API_URL=http://localhost/api

# ------------------
# pgAdmin
# ------------------
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# ------------------
# Docker Production
# ------------------
APP_PORT=80

