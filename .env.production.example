# ===========================================
# TRACKING SPESE - Production Environment
# ===========================================
# 
# IMPORTANTE: Copia questo file in .env prima del deploy su Portainer
# Sostituisci tutti i valori con le tue configurazioni di produzione
#
# ===========================================

# ------------------
# Database
# ------------------
POSTGRES_DB=tracking_spese_prod
POSTGRES_USER=tracking_user_prod
POSTGRES_PASSWORD=CAMBIA_CON_PASSWORD_FORTE_32_CARATTERI

# ------------------
# Backend API
# ------------------
DATABASE_URL=postgresql://tracking_user_prod:CAMBIA_CON_PASSWORD_FORTE_32_CARATTERI@db:5432/tracking_spese_prod
JWT_SECRET=CAMBIA_CON_CHIAVE_JWT_LUNGA_64_CARATTERI
JWT_EXPIRY=7d
NODE_ENV=production
PORT=3000

# ------------------
# Frontend
# ------------------
FRONTEND_URL=https://tuo-dominio.duckdns.org
VITE_API_URL=/api

# ------------------
# pgAdmin
# ------------------
PGADMIN_EMAIL=admin@tuodominio.com
PGADMIN_PASSWORD=CAMBIA_CON_PASSWORD_ADMIN_FORTE

# ------------------
# Docker Production
# ------------------
APP_PORT=80

